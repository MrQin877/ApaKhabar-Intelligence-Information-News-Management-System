# Copy to deployment/.env; never copy live XAMPP database settings into this file.
COMPOSE_PROJECT_NAME=apakhabar-docker
WEB_PORT=8088
DB_DATABASE=apakhabar_docker
DB_USERNAME=apakhabar
DB_PASSWORD=replace-with-a-new-docker-only-password
DB_ROOT_PASSWORD=replace-with-a-different-docker-only-password
APAKHABAR_AI_SERVICE_TOKEN=replace-with-a-long-random-shared-token

# Paths are resolved relative to deployment/compose.yaml. Use absolute Windows paths if different.
AI_REPO_PATH=../../PROJECT/ApaKhabar-AI-Service
AI_DOCKERFILE=../../ApaKhabar-Intelligence-Information-News-Management-System/deployment/docker/ai.Dockerfile
