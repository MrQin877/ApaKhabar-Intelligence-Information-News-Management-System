# Team setup template. Replace credentials privately; never commit the real env file.
# Compose interpolation settings; the shared token is supplied to both services.
COMPOSE_PROJECT_NAME=apakhabar-docker
DB_DATABASE=apakhabar_docker
DB_USERNAME=apakhabar
DB_PASSWORD=replace-with-docker-db-password
DB_ROOT_PASSWORD=replace-with-docker-root-password
APAKHABAR_AI_SERVICE_TOKEN=replace-with-your-apakhabar-ai-service-token
WEB_PORT=8088
# Repo B remains separate. Paths are relative to deployment/compose.yaml.
AI_REPO_PATH=../../PROJECT/ApaKhabar-AI-Service
AI_DOCKERFILE=../../ApaKhabar-Intelligence-Information-News-Management-System/deployment/docker/ai.Dockerfile
