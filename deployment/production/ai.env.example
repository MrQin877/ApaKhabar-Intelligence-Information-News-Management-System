# Copy to the same filename without .example; edit real values privately there.
# Only values needing replacement have comments. No secrets belong in this template.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# PREVIOUS FILE: deployment/ai.env -> AI_API_KEY. Replace exposed credentials through the issuing provider before production use.
AI_API_KEY=replace-with-your-ai-api-key
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=180
AI_MAX_TOKENS=4096
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DEVICE=auto
EMBEDDING_DIMENSIONS=768
AGENT_ENABLED=true
AGENT_DB_PATH=/app/data/agent/checkpoints.sqlite
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_REVISIONS=2
AGENT_MAX_SECONDS=900
AGENT_QUALITY_TARGET=80
CHROMA_PATH=/app/data/chroma
UPLOAD_PATH=/app/data/uploads
MAX_UPLOAD_MB=20
OCR_LANGUAGE=ind+eng
OCR_MAX_PAGES=100
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.75
EVALUATOR_ENABLED=true
EVALUATOR_BASE_URL=https://api.groq.com/openai/v1
# PREVIOUS FILE: deployment/ai.env -> EVALUATOR_API_KEY. Replace exposed credentials through the issuing provider before production use.
EVALUATOR_API_KEY=replace-with-your-groq-api-key
EVALUATOR_MODEL=openai/gpt-oss-120b
EVALUATOR_TIMEOUT_SECONDS=180
EVALUATOR_MAX_TOKENS=4096
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# PREVIOUS FILE: deployment/ai.env -> EMBEDDING_API_KEY. Replace exposed credentials through the issuing provider before production use.
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
WEB_SEARCH_URL=
# PREVIOUS FILE: deployment/ai.env -> WEB_SEARCH_API_KEY. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
WEB_SEARCH_API_KEY=replace-with-your-web-search-api-key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# PREVIOUS FILE: deployment/ai.env -> LANGCHAIN_API_KEY. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
LANGCHAIN_API_KEY=replace-with-your-langchain-api-key
LANGCHAIN_PROJECT=ApaKhabar-Agent
AGENT_SKILLS_PATH=/app/skills
# CREATE: Generate one random production secret; use the same value in all three production env files. Not an Azure key.
APAKHABAR_AI_SERVICE_TOKEN=replace-with-your-apakhabar-ai-service-token
HF_HOME=/app/data/huggingface
