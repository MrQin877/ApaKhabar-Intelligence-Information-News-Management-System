# Copy to the same filename without .example; edit real values privately there.
# Only values needing replacement have comments. No secrets belong in this template.
APP_NAME=ApaKhabar
APP_ENV=production
# PREVIOUS FILE: deployment/laravel.env -> APP_KEY. Preserve the existing key when migrating data; do not replace it blindly.
APP_KEY=replace-with-your-app-key
APP_DEBUG=false
# CREATE/CONFIGURE: Replace with your public HTTPS domain; use the same APP_URL in production/.env and production/laravel.env. Point its DNS to the Azure VM.
APP_URL=https://news.example.org
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=apakhabar_production
DB_USERNAME=apakhabar
# CREATE: Choose a strong production DB user password; use the same value in production/.env and production/laravel.env. Restored DB credentials must agree; env edits do not reset them.
DB_PASSWORD=replace-with-production-db-password
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# PREVIOUS FILE: deployment/laravel.env -> MAIL_USERNAME. Replace exposed credentials through the issuing provider before production use.
MAIL_USERNAME=replace-with-your-mail-username
# PREVIOUS FILE: deployment/laravel.env -> MAIL_PASSWORD. Replace exposed credentials through the issuing provider before production use.
MAIL_PASSWORD=replace-with-your-mail-password
# PREVIOUS FILE: deployment/laravel.env -> MAIL_FROM_ADDRESS. Replace exposed credentials through the issuing provider before production use.
MAIL_FROM_ADDRESS=replace-with-your-mail-from-address
MAIL_FROM_NAME=ApaKhabar
# PREVIOUS FILE: deployment/laravel.env -> VONAGE_KEY. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
VONAGE_KEY=replace-with-your-vonage-key
# PREVIOUS FILE: deployment/laravel.env -> VONAGE_SECRET. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
VONAGE_SECRET=replace-with-your-vonage-secret
# PREVIOUS FILE: deployment/laravel.env -> VONAGE_SMS_FROM. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
VONAGE_SMS_FROM=replace-with-your-vonage-sms-from
# PREVIOUS FILE: deployment/laravel.env -> BULK360_APP_KEY. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
BULK360_APP_KEY=replace-with-your-bulk360-app-key
# PREVIOUS FILE: deployment/laravel.env -> BULK360_APP_SECRET. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
BULK360_APP_SECRET=replace-with-your-bulk360-app-secret
# PREVIOUS FILE: deployment/laravel.env -> BULK360_FROM. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
BULK360_FROM=replace-with-your-bulk360-from
# PREVIOUS FILE: deployment/laravel.env -> WHAPI_TOKEN. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
WHAPI_TOKEN=replace-with-your-whapi-token
# PREVIOUS FILE: deployment/laravel.env -> WHAPI_VILLAGER_GROUP. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
