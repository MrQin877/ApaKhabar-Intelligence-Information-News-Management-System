# PREVIOUS FILE: deployment/laravel.env -> INSTAGRAM_ACCESS_TOKEN. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
INSTAGRAM_ACCESS_TOKEN=replace-with-your-instagram-access-token
# PREVIOUS FILE: deployment/laravel.env -> CLOUDINARY_CLOUD_NAME. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
CLOUDINARY_CLOUD_NAME=replace-with-your-cloudinary-cloud-name
# PREVIOUS FILE: deployment/laravel.env -> CLOUDINARY_API_KEY. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
CLOUDINARY_API_KEY=replace-with-your-cloudinary-api-key
# PREVIOUS FILE: deployment/laravel.env -> CLOUDINARY_API_SECRET. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-api-secret
META_INSTAGRAM_DISCOVERY_DIAGNOSTICS=false
# PREVIOUS FILE: deployment/laravel.env -> OPENAI_API_KEY. Replace exposed credentials through the issuing provider before production use.
OPENAI_API_KEY=replace-with-your-openai-api-key
ENGAGEMENT_ANONYMOUS_RETENTION_DAYS=90
FFPROBE_BINARY=/usr/bin/ffprobe
VITE_APP_NAME=ApaKhabar
NEWS_MEDIA_DISK=public
DB_QUEUE_RETRY_AFTER=1500
APAKHABAR_AI_URL=http://ai:8001
APAKHABAR_AI_API_PREFIX=
APAKHABAR_AI_TIMEOUT=1200
APAKHABAR_AI_CONNECT_TIMEOUT=5
LIBRETRANSLATE_URL=http://libretranslate:5000
FFMPEG_BINARY=ffmpeg
MOBILE_VERIFICATION_RETURN_URL=apakhabarmobileapp:///verify-email
VITE_API_BASE_URL=
SESSION_SECURE_COOKIE=true
