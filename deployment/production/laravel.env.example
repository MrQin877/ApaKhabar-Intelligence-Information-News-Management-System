WHAPI_EMPLOYEE_GROUP=replace-with-your-whapi-employee-group
MOBILE_PASSWORD_RESET_RETURN_URL=apakhabarmobileapp:///reset-password
# PREVIOUS FILE: deployment/laravel.env -> FACEBOOK_APP_ID. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
