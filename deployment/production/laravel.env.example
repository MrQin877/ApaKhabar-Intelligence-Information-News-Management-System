FACEBOOK_GRAPH_VERSION=v26.0
# PREVIOUS FILE: deployment/laravel.env -> FACEBOOK_PAGE_ID. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
