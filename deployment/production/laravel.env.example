FACEBOOK_REDIRECT_URI=https://news.example.org/admin/social/facebook/callback
# PREVIOUS FILE: deployment/laravel.env -> FACEBOOK_LOGIN_CONFIG_ID. Replace exposed credentials through the issuing provider before production use. Clear related placeholders if this integration is unused.
