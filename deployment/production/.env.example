# Copy to the same filename without .example; edit real values privately there.
# Only values needing replacement have comments. No secrets belong in this template.
COMPOSE_PROJECT_NAME=apakhabar-production
# CREATE/CONFIGURE: Replace with your public HTTPS domain; use the same APP_URL in production/.env and production/laravel.env. Point its DNS to the Azure VM.
APP_URL=https://news.example.org
WEB_BIND_HOST=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
DB_DATABASE=apakhabar_production
DB_USERNAME=apakhabar
# CREATE: Choose a strong production DB user password; use the same value in production/.env and production/laravel.env. Restored DB credentials must agree; env edits do not reset them.
DB_PASSWORD=replace-with-production-db-password
# CREATE: Choose a strong production DB administrator password. For a restored DB, retain its password until deliberately changed; env edits do not reset it.
DB_ROOT_PASSWORD=replace-with-production-root-password
# CREATE: Generate one random production secret; use the same value in all three production env files. Not an Azure key.
APAKHABAR_AI_SERVICE_TOKEN=replace-with-your-apakhabar-ai-service-token
AI_REPO_PATH=../../PROJECT/ApaKhabar-AI-Service
AI_DOCKERFILE=../../ApaKhabar-Intelligence-Information-News-Management-System/deployment/docker/ai.Dockerfile
TLS_CERT_DIR=/etc/apakhabar/tls
MARIADB_DATA_VOLUME=apakhabar-production_mariadb_data
LARAVEL_STORAGE_VOLUME=apakhabar-production_laravel_storage
AI_CHROMA_VOLUME=apakhabar-production_ai_chroma
AI_UPLOADS_VOLUME=apakhabar-production_ai_uploads
AI_CHECKPOINTS_VOLUME=apakhabar-production_ai_checkpoints
AI_MODEL_CACHE_VOLUME=apakhabar-production_ai_model_cache
TRANSLATION_MODELS_VOLUME=apakhabar-production_translation_models
