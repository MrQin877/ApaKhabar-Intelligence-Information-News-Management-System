# Matches the local environment layout. Fill credentials privately; never commit real keys.


AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemma-4-26b-a4b-it
AI_TIMEOUT_SECONDS=180
AI_MAX_TOKENS=4096

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DEVICE=auto
EMBEDDING_DIMENSIONS=768

AGENT_ENABLED=true
AGENT_DB_PATH=/app/data/agent/checkpoints.sqlite
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_REVISIONS=2
AGENT_MAX_SECONDS=900
AGENT_QUALITY_TARGET=80

CHROMA_PATH=/app/data/chroma
UPLOAD_PATH=/app/data/uploads
MAX_UPLOAD_MB=20

OCR_LANGUAGE=ind+eng
OCR_MAX_PAGES=100
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.75

EVALUATOR_ENABLED=true
EVALUATOR_BASE_URL=https://api.groq.com/openai/v1
EVALUATOR_API_KEY=replace-with-your-groq-api-key
EVALUATOR_MODEL=openai/gpt-oss-120b
EVALUATOR_TIMEOUT_SECONDS=180
EVALUATOR_MAX_TOKENS=4096


EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=

WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=

LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ApaKhabar-Agent

# Compose supplies APAKHABAR_AI_SERVICE_TOKEN from deployment/.env.
# EVALUATOR_BASE_URL uses Groq for the configured openai/gpt-oss-120b model.
# Optional skill location (otherwise resolved by the application).
AGENT_SKILLS_PATH=/app/skills
