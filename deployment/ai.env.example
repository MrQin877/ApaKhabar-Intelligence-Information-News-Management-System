# Copy to ai.env. Keep real credentials only in the ignored ai.env file.
# Docker Compose supplies APAKHABAR_AI_SERVICE_TOKEN from deployment/.env.

# Gemini writer (OpenAI-compatible Chat Completions endpoint).
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=180
AI_MAX_TOKENS=4096

# Separate OpenAI judge; do not disable for the unified workflow.
EVALUATOR_ENABLED=true
EVALUATOR_BASE_URL=https://api.openai.com/v1
EVALUATOR_API_KEY=
EVALUATOR_MODEL=gpt-4.1-mini
EVALUATOR_TIMEOUT_SECONDS=180
EVALUATOR_MAX_TOKENS=4096

# OpenAI embeddings for embedded ChromaDB. Reindex separately when changing
# the model or dimensions; preserve the existing volume and old collections.
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# LangGraph and persistent Docker paths.
AGENT_ENABLED=true
AGENT_DB_PATH=/app/data/agent/checkpoints.sqlite
AGENT_SKILLS_PATH=/app/skills
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_REVISIONS=2
AGENT_MAX_SECONDS=900
AGENT_QUALITY_TARGET=80
CHROMA_PATH=/app/data/chroma
UPLOAD_PATH=/app/data/uploads

# Document extraction and retrieval.
MAX_UPLOAD_MB=20
OCR_LANGUAGE=ind+eng
OCR_MAX_PAGES=100
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.75

# Optional external integrations.
WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ApaKhabar-Agent
