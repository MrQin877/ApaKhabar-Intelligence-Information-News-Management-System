
# ==========================================
# ApaKhabar AI Service - Docker
# ==========================================

# 1. AI Writer - Google Gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL=YOUR_EXISTING_GEMINI_MODEL
AI_TIMEOUT_SECONDS=180
AI_MAX_TOKENS=4096

# 2. Document Embeddings - Gemini API
# Alternatives: embedding_gemma (local cache) or openai. Switching providers
# creates a new Chroma collection; reindex approved information separately.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DEVICE=auto
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=

# 3. LangGraph Agent
AGENT_ENABLED=true
AGENT_DB_PATH=/app/data/agent/checkpoints.sqlite
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_REVISIONS=2
AGENT_MAX_SECONDS=900
AGENT_QUALITY_TARGET=80

# 4. Storage
CHROMA_PATH=/app/data/chroma
UPLOAD_PATH=/app/data/uploads
MAX_UPLOAD_MB=20

# 5. Document Extraction and RAG
OCR_LANGUAGE=ind+eng
OCR_MAX_PAGES=100
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.75

# 6. AI Evaluator - OpenAI
EVALUATOR_ENABLED=true
EVALUATOR_BASE_URL=https://api.openai.com/v1
EVALUATOR_API_KEY=YOUR_NEW_OPENAI_API_KEY
EVALUATOR_MODEL=YOUR_EXISTING_OPENAI_MODEL
EVALUATOR_TIMEOUT_SECONDS=180
EVALUATOR_MAX_TOKENS=4096

# 7. Laravel Integration
# Token supplied by deployment/.env via Docker Compose.
# Do not set a different value here.

# 8. Optional OpenAI embedding endpoint (only when EMBEDDING_PROVIDER=openai)
EMBEDDING_BASE_URL=https://api.openai.com/v1

# 9. Optional Web Search
WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=

# 10. LangSmith - Disabled
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ApaKhabar-Agent
