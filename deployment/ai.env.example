# Team setup template. Replace credentials privately; never commit the real env file.
# Gemini writer + Gemini embeddings + independent OpenAI judge.
# Shared APAKHABAR_AI_SERVICE_TOKEN comes from deployment/.env via Compose.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=replace-with-your-ai-api-key
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=180
AI_MAX_TOKENS=4096
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DEVICE=auto
EMBEDDING_DIMENSIONS=768
AGENT_ENABLED=true
AGENT_DB_PATH=/app/data/agent/checkpoints.sqlite
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_REVISIONS=2
AGENT_MAX_SECONDS=900
AGENT_QUALITY_TARGET=80
CHROMA_PATH=/app/data/chroma
UPLOAD_PATH=/app/data/uploads
MAX_UPLOAD_MB=20
OCR_LANGUAGE=ind+eng
OCR_MAX_PAGES=100
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.75
EVALUATOR_ENABLED=true
EVALUATOR_BASE_URL=https://api.openai.com/v1
EVALUATOR_API_KEY=replace-with-your-evaluator-api-key
EVALUATOR_MODEL=gpt-4.1-mini
EVALUATOR_TIMEOUT_SECONDS=180
EVALUATOR_MAX_TOKENS=4096
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=replace-with-your-web-search-api-key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=replace-with-your-langchain-api-key
LANGCHAIN_PROJECT=ApaKhabar-Agent
AGENT_SKILLS_PATH=/app/skills
# OpenAI alternative: EMBEDDING_PROVIDER=openai with a compatible embedding model/key.
# Local alternative: embedding_gemma requires INSTALL_LOCAL_EMBEDDINGS=true and a seeded cache.
