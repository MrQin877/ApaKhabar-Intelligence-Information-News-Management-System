# Copy to laravel.env and merge any needed values from the existing Laravel .env.
# Do not change the existing XAMPP .env. Compose overrides DB, AI URL, queue, FFmpeg, and APP_URL.
APP_NAME=ApaKhabar
APP_ENV=local
APP_DEBUG=true
APP_KEY=replace-with-a-separate-key-or-use-the-backed-up-key-with-restored-data
SESSION_DRIVER=cookie
FILESYSTEM_DISK=local
NEWS_MEDIA_DISK=public
CACHE_STORE=file
MAIL_MAILER=log
APAKHABAR_AI_TIMEOUT=1200
APAKHABAR_AI_CONNECT_TIMEOUT=5
VITE_API_BASE_URL=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8088/admin/social/facebook/callback
FACEBOOK_LOGIN_CONFIG_ID=
INSTAGRAM_FACEBOOK_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v25.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OPENAI_API_KEY=
