# Team setup template. Replace credentials privately; never commit the real env file.
# Compose overrides DB, APP_URL, AI URL/token, queues, translation URL and FFmpeg.
# Fill enabled integration credentials; leave unused optional integration values empty.
APP_NAME=ApaKhabar
APP_ENV=local
APP_KEY=replace-with-your-app-key
APP_DEBUG=false
APP_URL=http://localhost:8088
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=apakhabar_docker
DB_USERNAME=apakhabar
DB_PASSWORD=replace-with-docker-db-password
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-your-mail-username
MAIL_PASSWORD=replace-with-your-mail-password
MAIL_FROM_ADDRESS=replace-with-your-mail-from-address
MAIL_FROM_NAME=ApaKhabar
VONAGE_KEY=replace-with-your-vonage-key
VONAGE_SECRET=replace-with-your-vonage-secret
VONAGE_SMS_FROM=replace-with-your-vonage-sms-from
BULK360_APP_KEY=replace-with-your-bulk360-app-key
BULK360_APP_SECRET=replace-with-your-bulk360-app-secret
BULK360_FROM=replace-with-your-bulk360-from
WHAPI_TOKEN=replace-with-your-whapi-token
WHAPI_VILLAGER_GROUP=replace-with-your-whapi-villager-group
WHAPI_EMPLOYEE_GROUP=replace-with-your-whapi-employee-group
# Installed app fallback; Expo Go supplies its current session URL with each reset request.
MOBILE_PASSWORD_RESET_RETURN_URL=apakhabarmobileapp:///reset-password
FACEBOOK_APP_ID=replace-with-your-facebook-app-id
FACEBOOK_APP_SECRET=replace-with-your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:8088/admin/social/facebook/callback
FACEBOOK_LOGIN_CONFIG_ID=replace-with-your-facebook-login-config-id
INSTAGRAM_FACEBOOK_LOGIN_CONFIG_ID=replace-with-your-instagram-facebook-login-config-id
META_GRAPH_VERSION=v25.0
FACEBOOK_GRAPH_VERSION=v26.0
FACEBOOK_PAGE_ID=replace-with-your-facebook-page-id
FACEBOOK_PAGE_ACCESS_TOKEN=replace-with-your-facebook-page-access-token
INSTAGRAM_USER_ID=replace-with-your-instagram-user-id
INSTAGRAM_ACCESS_TOKEN=replace-with-your-instagram-access-token
CLOUDINARY_CLOUD_NAME=replace-with-your-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-your-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-api-secret
META_INSTAGRAM_DISCOVERY_DIAGNOSTICS=true
OPENAI_API_KEY=replace-with-your-openai-api-key
ENGAGEMENT_ANONYMOUS_RETENTION_DAYS=90
FFPROBE_BINARY=/usr/bin/ffprobe
AWS_ACCESS_KEY_ID=replace-with-your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=replace-with-your-aws-bucket
AWS_USE_PATH_STYLE_ENDPOINT=false
VITE_APP_NAME=ApaKhabar
NEWS_MEDIA_DISK=public
DB_QUEUE_RETRY_AFTER=1500
APAKHABAR_AI_URL=http://ai:8001
APAKHABAR_AI_API_PREFIX=
APAKHABAR_AI_TIMEOUT=1200
APAKHABAR_AI_CONNECT_TIMEOUT=5
LIBRETRANSLATE_URL=http://libretranslate:5000
FFMPEG_BINARY=ffmpeg
MOBILE_VERIFICATION_RETURN_URL=apakhabarmobileapp:///verify-email
VITE_API_BASE_URL=
