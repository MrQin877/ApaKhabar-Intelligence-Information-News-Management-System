APP_NAME=ApaKhabar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Meta developer app settings. Leave blank until configured; never expose secrets with VITE_.
# Optional override; defaults to /admin/social/facebook/callback on the application origin. Register the exact URI in Meta.
# Optional Facebook Login for Business configuration IDs, one permission set per platform.
MOBILE_VERIFICATION_RETURN_URL=apakhabarmobileapp:///verify-email
MOBILE_PASSWORD_RESET_RETURN_URL=apakhabarmobileapp:///reset-password

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apakahbar
DB_USERNAME=root
DB_PASSWORD=

# Server-side sessions preserve OAuth state across concurrent browser requests.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
NEWS_MEDIA_DISK=public
# For private cloud document storage, set FILESYSTEM_DISK=s3 and configure:
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION, and AWS_BUCKET.
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1500

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Leave empty to use the Laravel page's origin (recommended for session auth).
# Optional backend origin only, without /api; restart Vite after changing.
VITE_API_BASE_URL=

APAKHABAR_AI_URL=http://127.0.0.1:8001
# Leave blank for the current compatible routes. Set to /v1 only after the
# deployed FastAPI instance confirms that versioned routes are available.
APAKHABAR_AI_API_PREFIX=
APAKHABAR_AI_SERVICE_TOKEN=
APAKHABAR_AI_PROVIDER="AI lokal"
APAKHABAR_AI_TIMEOUT=1200
APAKHABAR_AI_CONNECT_TIMEOUT=5

# SMS and WhatsApp Configuration
BULK360_APP_KEY=
BULK360_APP_SECRET=
BULK360_FROM=68068

WHAPI_TOKEN=
WHAPI_VILLAGER_GROUP=
WHAPI_EMPLOYEE_GROUP=

# Local translation service (compose.translation.yaml). Never exposed to the browser.
LIBRETRANSLATE_URL=http://127.0.0.1:5005
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_TIMEOUT=45
TRANSLATION_CACHE_STORE=file

# Server-only Instagram API with Instagram Login credentials.


# Server-only Facebook Page publishing


# Temporary safe Instagram discovery logging; disable after diagnosis.

# ===== Meta integrations and publishing configuration =====

# Application URL
APP_URL=http://localhost:8000

# Shared Meta OAuth app credentials and callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/admin/social/facebook/callback

# Facebook Login for Business configurations
FACEBOOK_LOGIN_CONFIG_ID=
# Duplicate retained inactive; use the single entry above.
# FACEBOOK_LOGIN_CONFIG_ID=
INSTAGRAM_FACEBOOK_LOGIN_CONFIG_ID=
# Duplicate retained inactive; use the single entry above.
# INSTAGRAM_FACEBOOK_LOGIN_CONFIG_ID=

# Graph API versions
META_GRAPH_VERSION=v25.0
FACEBOOK_GRAPH_VERSION=v26.0

# Legacy publishing fallback: used only when this user has no saved connection
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Obsolete direct Instagram OAuth: no longer read; values retained as comments
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=

# Cloudinary: still required by image publishing
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Temporary safe diagnostics: disable after investigation
META_INSTAGRAM_DISCOVERY_DIAGNOSTICS=false

# Server-only comment moderation; missing key holds comments for review.
OPENAI_API_KEY=
ENGAGEMENT_ANONYMOUS_RETENTION_DAYS=90

# Video Pendek: ffprobe must be installed on the PHP upload server.
FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=
